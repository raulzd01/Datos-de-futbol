<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cómo mantener esto al día:
  - Cada vez que publiques un artículo nuevo en articulos/, añade un
    bloque <url> más aquí abajo (copia uno de <url>...</url> y cambia
    el <loc> y el <lastmod>).
  - Actualiza <lastmod> de clasificacion.html cuando cambie el diseño
    de la página (no hace falta tocarlo por la actualización diaria de
    datos, eso lo lee Google del contenido, no del sitemap).
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <url>
    <loc>https://datosdefutbol.com/index.html</loc>
    <lastmod>2026-07-27</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>

  <url>
    <loc>https://datosdefutbol.com/clasificacion.html</loc>
    <lastmod>2026-07-27</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>

  <url>
    <loc>https://datosdefutbol.com/articulos.html</loc>
    <lastmod>2026-07-27</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>

  <!-- Artículos individuales: añade uno por cada publicación real.
       Ejemplo (descomenta y edita cuando publiques el primero real):

  <url>
    <loc>https://datosdefutbol.com/articulos/nombre-del-articulo.html</loc>
    <lastmod>2026-07-27</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  -->

</urlset>
